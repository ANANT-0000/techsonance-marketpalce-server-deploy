<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <style>
      /* Reset & Clean Typography */
      body {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0;
        color: #222;
        font-size: 11px;
        line-height: 1.6;
      }
      .container {
        padding: 40px 50px;
        position: relative;
      }

      h1 {
        font-size: 32px;
        font-weight: 300;
        letter-spacing: 3px;
        color: #111;
        margin: 0 0 15px 0;
        text-transform: uppercase;
        text-align: right;
      }
      h2 {
        font-size: 13px;
        font-weight: 600;
        color: #111;
        margin: 0 0 5px 0;
      }

      .text-muted {
        color: #666;
      }

      /* Layout Helpers */
      .flex-row {
        display: flex;
        justify-content: space-between;
      }
      .mb-20 {
        margin-bottom: 20px;
      }
      .mb-40 {
        margin-bottom: 40px;
      }

      /* Header */
      .header {
        align-items: flex-start;
        border-bottom: 1px solid #eaeaea;
        padding-bottom: 30px;
      }
      .logo {
        max-height: 50px;
        margin-bottom: 15px;
      }

      /* Meta Table (Invoice #, Date) */
      .meta-table {
        text-align: right;
        margin-left: auto;
        border-collapse: collapse;
      }
      .meta-table td {
        padding: 4px 0 4px 20px;
      }
      .meta-table td:first-child {
        color: #888;
        text-transform: uppercase;
        font-size: 9px;
        letter-spacing: 1px;
      }
      .meta-table td:last-child {
        font-weight: 600;
        color: #111;
      }

      /* Addresses */
      .addresses {
        display: flex;
        gap: 50px;
      }
      .address-block {
        flex: 1;
      }
      .address-label {
        font-size: 9px;
        text-transform: uppercase;
        color: #aaa;
        letter-spacing: 1px;
        margin-bottom: 8px;
        font-weight: 600;
      }

      /* Minimalist Items Table */
      .invoice-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
      }
      .invoice-table th {
        padding: 12px 0;
        border-bottom: 1px solid #111;
        font-weight: 600;
        text-align: right;
        color: #111;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .invoice-table th.left {
        text-align: left;
      }
      .invoice-table td {
        padding: 14px 0;
        border-bottom: 1px solid #f4f4f4;
        vertical-align: top;
        text-align: right;
      }
      .invoice-table td.left {
        text-align: left;
      }

      .item-name {
        font-weight: 600;
        color: #111;
        font-size: 12px;
      }

      /* Totals Block */
      .totals-container {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
      }
      .totals-table {
        width: 280px;
        border-collapse: collapse;
      }
      .totals-table td {
        padding: 6px 0;
        text-align: right;
        border-bottom: 1px solid #f9f9f9;
      }
      .totals-table td:first-child {
        color: #666;
        text-align: left;
        font-size: 11px;
      }
      .totals-table tr.grand-total td {
        font-size: 16px;
        font-weight: bold;
        color: #111;
        border-bottom: none;
        padding-top: 15px;
        border-top: 1px solid #111;
        margin-top: 5px;
      }

      /* Words Amount */
      .amount-words {
        font-size: 9px;
        color: #888;
        text-transform: uppercase;
        text-align: right;
        margin-top: 5px;
      }

      /* Footer */
      .footer {
        margin-top: 50px;
        padding-top: 20px;
        display: flex;
        justify-content: space-between;
        page-break-inside: avoid;
      }
      .footer-left {
        width: 60%;
        font-size: 10px;
        color: #555;
      }
      .footer-right {
        width: 35%;
        text-align: right;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
      }
      .footer-label {
        font-size: 9px;
        font-weight: bold;
        color: #111;
        text-transform: uppercase;
        margin-bottom: 6px;
        letter-spacing: 1px;
      }
    </style>
  </head>
  <body>
    <div class='container'>

      <div class='flex-row header mb-40'>
        <div class='company-info'>
          {{#if branding.logoUrl}}<img
              src='{{branding.logoUrl}}'
              class='logo'
            />{{/if}}

          <h2>{{legal.tradeName}}</h2>
          <div class='text-muted'>
            {{#each legal.taxIds}}<div>{{key}}: {{value}}</div>{{/each}}
            {{#if legal.supportEmail}}<div>{{legal.supportEmail}}</div>{{/if}}
          </div>
        </div>
        <div class='invoice-meta'>
          <h1>INVOICE</h1>
          <table class='meta-table'>
            <tr><td>Invoice No.</td><td>{{meta.invoiceNumber}}</td></tr>
            <tr><td>Date</td><td>{{meta.invoiceDate}}</td></tr>
            {{#if meta.dueDate}}<tr><td>Due Date</td><td
                >{{meta.dueDate}}</td></tr>{{/if}}
          </table>
        </div>
      </div>

      <div class='addresses mb-40'>
        <div class='address-block'>
          <div class='address-label'>Billed To</div>
          <h2>{{customer.name}}</h2>
          <div class='text-muted'>
            {{customer.billingAddress.addressLine1}}<br />
            {{customer.billingAddress.city}},
            {{customer.billingAddress.state}}
            -
            {{customer.billingAddress.pincode}}<br />
            {{#if customer.phone}}Ph: {{customer.phone}}{{/if}}
          </div>
        </div>
        <div class='address-block'>
          <div class='address-label'>Shipped To</div>
          <h2>{{customer.name}}</h2>
          <div class='text-muted'>
            {{customer.shippingAddress.addressLine1}}<br />
            {{customer.shippingAddress.city}},
            {{customer.shippingAddress.state}}
            -
            {{customer.shippingAddress.pincode}}
          </div>
        </div>
      </div>

      <table class='invoice-table mb-20'>
        <thead>
          <tr>
            <th class='left' style='width: 5%;'>#</th>
            <th class='left' style='width: 45%;'>Description</th>
            <th>Rate</th>
            <th>Qty</th>
            <th>Tax</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
            <tr>
              <td class='left text-muted'>{{index}}</td>
              <td class='left'>
                <div class='item-name'>{{name}}</div>
              </td>
              <td class='text-muted'>{{unitPrice}}</td>
              <td class='text-muted'>{{quantity}}</td>
              <td class='text-muted'>{{taxRate}}</td>
              <td style='font-weight: 600; color: #111;'>{{totalAmount}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>

      <div class='totals-container mb-40'>
        <div>
          <table class='totals-table'>
            <tr><td>Subtotal</td><td>{{totals.subTotal}}</td></tr>

            {{#if totals.totalCgst}}
              <tr><td>CGST</td><td>{{totals.totalCgst}}</td></tr>
            {{/if}}

            {{#if totals.totalSgst}}
              <tr><td>SGST</td><td>{{totals.totalSgst}}</td></tr>
            {{/if}}

            {{#if totals.totalIgst}}
              <tr><td>IGST</td><td>{{totals.totalIgst}}</td></tr>
            {{/if}}

            <tr class='grand-total'><td>Total Due</td><td
              >{{totals.grandTotal}}</td></tr>
          </table>

          {{#if totals.grandTotalInWords}}
            <div class='amount-words'>{{totals.grandTotalInWords}}</div>
          {{/if}}
        </div>
      </div>

      <div class='footer'>
        <div class='footer-left'>
          {{#if footer.termsAndConditions}}
            <div class='footer-label'>Terms & Conditions</div>
            <div
              style='margin-bottom: 15px;'
            >{{footer.termsAndConditions}}</div>
          {{/if}}
          {{#if footer.notes}}
            <div class='footer-label'>Notes</div>
            <div>{{footer.notes}}</div>
          {{/if}}
        </div>
        <div class='footer-right'>
          <div
            style='padding-top: 40px; border-bottom: 1px solid #111; width: 150px; margin-bottom: 8px;'
          ></div>
          <b>For {{legal.tradeName}}</b>
          <span
            class='text-muted'
            style='font-size: 9px;'
          >{{footer.signatoryName}}</span>
        </div>
      </div>

    </div>
  </body>
</html>