<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: {{#if branding.fontFamily}}{{branding.fontFamily}}{{else}}'Arial', 'Helvetica Neue', sans-serif{{/if}};
      font-size: 11px;
      line-height: 1.5;
      color: #111;
      background: #fff;
    }

    a { color: inherit; text-decoration: none; }

    .page { padding: 28px 36px; position: relative; max-width: 800px; margin: 0 auto; }

    /* ── watermark ────────────────────────────────────── */
    {{#if branding.watermarkUrl}}
    .watermark {
      position: fixed; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.05; width: 380px; z-index: -1; pointer-events: none;
    }
    {{/if}}

    /* ── header ───────────────────────────────────────── */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid {{branding.primaryColor}};
      padding-bottom: 12px;
      margin-bottom: 14px;
    }
    .header-title h1 {
      font-size: 18px; font-weight: 700;
      color: {{branding.primaryColor}};
      text-transform: uppercase; letter-spacing: 0.5px;
    }
    .header-title .subtitle { font-size: 9px; color: #555; margin-top: 2px; }
    .header-logo img { max-height: 52px; max-width: 140px; object-fit: contain; }

    /* ── disclaimer banner ────────────────────────────── */
    .disclaimer {
      font-size: 8px; color: #666;
      border-bottom: 1px solid #e0e0e0;
      padding-bottom: 8px; margin-bottom: 12px;
      line-height: 1.45;
    }

    /* ── two-column layout ────────────────────────────── */
    .two-col { display: flex; gap: 20px; margin-bottom: 12px; }
    .two-col .col { flex: 1; }

    /* ── address blocks ───────────────────────────────── */
    .address-block { margin-bottom: 10px; }
    .address-block .block-label {
      font-size: 9px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.6px;
      color: #555; margin-bottom: 4px;
    }
    .address-block .recipient-name { font-weight: 700; font-size: 11px; margin-bottom: 2px; }
    .address-block .address-line { font-size: 9.5px; color: #333; line-height: 1.5; }
    .address-block .state-code { font-size: 9px; color: #333; font-weight: 700; margin-top: 2px; }

    /* ── tax IDs (GSTIN / PAN / CIN) ─────────────────── */
    .tax-ids { margin-top: 6px; }
    .tax-ids .tax-row {
      font-size: 9.5px; color: #222;
      margin-bottom: 2px;
    }
    .tax-ids .tax-row strong { font-weight: 700; }

    /* ── meta strip (Order / Invoice numbers + dates) ─── */
    .meta-strip {
      display: flex; gap: 0;
      border-top: 1px solid #ddd; border-bottom: 1px solid #ddd;
      padding: 8px 0; margin-bottom: 12px;
    }
    .meta-cell { flex: 1; font-size: 9px; }
    .meta-cell .lbl { color: #888; margin-bottom: 2px; }
    .meta-cell .val { font-weight: 700; font-size: 10px; color: #111; }

    /* ── place of supply strip ────────────────────────── */
    .supply-strip {
      font-size: 9px; color: #333;
      border-bottom: 1px solid #e0e0e0;
      padding-bottom: 7px; margin-bottom: 12px;
    }
    .supply-strip strong { font-weight: 700; }

    /* ── items table ──────────────────────────────────── */
    table.items {
      width: 100%; border-collapse: collapse;
      margin-bottom: 14px; font-size: 10px;
    }
    table.items thead tr { background-color: {{branding.primaryColor}}; }
    table.items thead th {
      color: #fff; padding: 7px 6px;
      font-size: 8.5px; font-weight: 600;
      text-align: right; white-space: nowrap;
    }
    table.items thead th:first-child,
    table.items thead th:nth-child(2) { text-align: left; }

    table.items tbody td {
      padding: 8px 6px; vertical-align: top;
      text-align: right; border-bottom: 1px solid #e8e8e8;
    }
    table.items tbody td:first-child,
    table.items tbody td:nth-child(2) { text-align: left; }
    table.items tbody tr:nth-child(even) { background: #f8f8f8; }

    .item-num { color: #888; font-size: 8.5px; }
    .item-name { font-weight: 700; font-size: 10.5px; margin-bottom: 2px; }
    .item-hsn { font-size: 8px; color: #777; margin-top: 1px; }
    .item-sku { font-size: 8px; color: #999; margin-top: 1px; }
    .item-desc { font-size: 8.5px; color: #888; margin-top: 2px; line-height: 1.35; }

    .tax-split { font-size: 8px; color: #666; margin-top: 2px; }

    /* ── totals ───────────────────────────────────────── */
    .totals-wrap { display: flex; justify-content: flex-end; margin-bottom: 12px; }
    .totals-box {
      width: 300px; border: 1px solid #ddd;
      border-radius: 4px; overflow: hidden;
    }
    .totals-row {
      display: flex; justify-content: space-between;
      padding: 5px 12px; font-size: 10px;
      border-bottom: 1px solid #f0f0f0; color: #333;
    }
    .totals-row:last-child { border-bottom: none; }
    .totals-row.grand {
      background-color: {{branding.primaryColor}};
      color: #fff; font-weight: 700; font-size: 12px; padding: 8px 12px;
    }
    .totals-row.indent { padding-left: 24px; font-size: 9.5px; color: #555; }

    /* ── amount in words ──────────────────────────────── */
    .amount-words {
      font-size: 9px; color: #333;
      background: #f7f7f7; border-left: 3px solid {{branding.primaryColor}};
      padding: 6px 10px; border-radius: 3px; margin-bottom: 14px;
      font-weight: 700;
    }
    .amount-words span { font-weight: 400; color: #555; }

    /* ── reverse charge ───────────────────────────────── */
    .reverse-charge { font-size: 9px; color: #444; margin-bottom: 14px; }

    /* ── signatory ────────────────────────────────────── */
    .signatory-wrap { display: flex; justify-content: flex-end; margin-bottom: 16px; }
    .signatory-box { width: 190px; text-align: center; }
    .signatory-box .for-label { font-size: 9px; color: #333; margin-bottom: 6px; font-weight: 700; }
    .sig-placeholder {
      width: 80px; height: 44px; border: 1.5px dashed #bbb; border-radius: 50%;
      margin: 0 auto 8px; display: flex; align-items: center;
      justify-content: center; font-size: 8px; color: #bbb;
    }
    .sig-img { height: 50px; object-fit: contain; margin-bottom: 6px; }
    .sig-name {
      font-size: 9.5px; font-weight: 700; color: #222;
      border-top: 1px solid #333; padding-top: 5px;
    }
    .sig-designation { font-size: 8.5px; color: #777; margin-top: 2px; }

    /* ── payment info ─────────────────────────────────── */
    .payment-table {
      width: 100%; border-collapse: collapse;
      font-size: 9px; margin-bottom: 14px;
    }
    .payment-table td {
      border: 1px solid #ddd; padding: 5px 8px;
    }
    .payment-table td:first-child { font-weight: 700; }

    /* ── notes / terms ────────────────────────────────── */
    .section { border-top: 1px solid #e0e0e0; padding-top: 9px; margin-bottom: 12px; }
    .section-heading {
      font-size: 9px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.5px; color: #333; margin-bottom: 5px;
    }
    .section-body { font-size: 8.5px; color: #555; line-height: 1.55; white-space: pre-line; }

    /* ── page footer ──────────────────────────────────── */
    .page-footer {
      border-top: 1px solid #ddd; padding-top: 6px;
      font-size: 8px; color: #aaa; text-align: center; margin-top: 10px;
    }

    @media print { .page { padding: 20px 28px; } }
  </style>
</head>
<body>
<div class="page">

  {{#if branding.watermarkUrl}}
  <img src="{{branding.watermarkUrl}}" class="watermark" alt="">
  {{/if}}

  <!-- ── HEADER ─────────────────────────────────────────────────── -->
  <div class="header">
    <div class="header-title">
      <h1>Tax Invoice / Bill of Supply / Cash Memo</h1>
      <div class="subtitle">(Original for Recipient)</div>
    </div>
    {{#if branding.logoUrl}}
    <div class="header-logo">
      <img src="{{branding.logoUrl}}" alt="Logo">
    </div>
    {{/if}}
  </div>

  {{#if footer.footerDisclaimer}}
  <div class="disclaimer">{{footer.footerDisclaimer}}</div>
  {{/if}}

  <!-- ── SOLD BY  |  BILLING + SHIPPING ────────────────────────── -->
  <div class="two-col">

    <!-- Left: Sold By -->
    <div class="col">
      <div class="address-block">
        <div class="block-label">Sold By :</div>
        <div class="recipient-name">{{seller.legalName}}</div>
        {{#if seller.tradeName}}
        {{#unless (eq seller.tradeName seller.legalName)}}
        <div class="address-line">({{seller.tradeName}})</div>
        {{/unless}}
        {{/if}}
        <div class="address-line">{{seller.address.addressLine1}}</div>
        {{#if seller.address.addressLine2}}<div class="address-line">{{seller.address.addressLine2}}</div>{{/if}}
        {{#if seller.address.street}}<div class="address-line">{{seller.address.street}}</div>{{/if}}
        <div class="address-line">{{seller.address.city}}, {{seller.address.state}}, {{seller.address.postalCode}}</div>
        <div class="address-line">{{seller.address.country}}</div>
      </div>

      <div class="tax-ids">
        {{#each seller.taxIds}}
        <div class="tax-row"><strong>{{key}}:</strong> {{value}}</div>
        {{/each}}
        {{#if seller.supportPhone}}<div class="tax-row"><strong>Phone:</strong> {{seller.supportPhone}}</div>{{/if}}
        {{#if seller.supportEmail}}<div class="tax-row"><strong>Email:</strong> {{seller.supportEmail}}</div>{{/if}}
      </div>
    </div>

    <!-- Right: Billing + Shipping stacked -->
    <div class="col">
      <div class="address-block">
        <div class="block-label">Billing Address :</div>
        <div class="recipient-name">{{customer.billingAddress.recipientName}}</div>
        <div class="address-line">{{customer.billingAddress.addressLine1}}</div>
        {{#if customer.billingAddress.addressLine2}}<div class="address-line">{{customer.billingAddress.addressLine2}}</div>{{/if}}
        <div class="address-line">{{customer.billingAddress.city}}, {{customer.billingAddress.state}}, {{customer.billingAddress.postalCode}}</div>
        <div class="address-line">{{customer.billingAddress.country}}</div>
        {{#if customer.billingAddress.stateCode}}<div class="state-code">State/UT Code: {{customer.billingAddress.stateCode}}</div>{{/if}}
      </div>

      <div class="address-block">
        <div class="block-label">Shipping Address :</div>
        <div class="recipient-name">{{customer.shippingAddress.recipientName}}</div>
        <div class="address-line">{{customer.shippingAddress.addressLine1}}</div>
        {{#if customer.shippingAddress.addressLine2}}<div class="address-line">{{customer.shippingAddress.addressLine2}}</div>{{/if}}
        <div class="address-line">{{customer.shippingAddress.city}}, {{customer.shippingAddress.state}}, {{customer.shippingAddress.postalCode}}</div>
        <div class="address-line">{{customer.shippingAddress.country}}</div>
        {{#if customer.shippingAddress.stateCode}}<div class="state-code">State/UT Code: {{customer.shippingAddress.stateCode}}</div>{{/if}}
        {{#if customer.placeOfSupply}}<div class="state-code">Place of supply: {{customer.placeOfSupply}}</div>{{/if}}
        {{#if customer.placeOfDelivery}}<div class="state-code">Place of delivery: {{customer.placeOfDelivery}}</div>{{/if}}
      </div>
    </div>

  </div>

  <!-- ── ORDER / INVOICE META ───────────────────────────────────── -->
  <div class="meta-strip">
    <div class="meta-cell">
      <div class="lbl">Order Number</div>
      <div class="val">{{meta.orderNumber}}</div>
    </div>
    <div class="meta-cell">
      <div class="lbl">Order Date</div>
      <div class="val">{{meta.orderDate}}</div>
    </div>
    <div class="meta-cell">
      <div class="lbl">Invoice Number</div>
      <div class="val">{{meta.invoiceNumber}}</div>
    </div>
    <div class="meta-cell">
      <div class="lbl">Invoice Date</div>
      <div class="val">{{meta.invoiceDate}}</div>
    </div>
  </div>

  <!-- ── ITEMS TABLE ────────────────────────────────────────────── -->
  <table class="items">
    <thead>
      <tr>
        <th style="width:26px">#</th>
        <th>Description</th>
        <th style="width:72px">Unit Price</th>
        <th style="width:55px">Discount</th>
        <th style="width:36px; text-align:center">Qty</th>
        <th style="width:78px">Net Amount</th>
        <th style="width:46px">Tax Rate</th>
        <th style="width:46px">Tax Type</th>
        <th style="width:70px">Tax Amount</th>
        <th style="width:78px">Total Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td><span class="item-num">{{index}}</span></td>
        <td>
          <div class="item-name">{{name}}</div>
          {{#if hsnCode}}<div class="item-hsn">HSN: {{hsnCode}}</div>{{/if}}
          {{#if sku}}<div class="item-sku">SKU: {{sku}}</div>{{/if}}
          {{#if description}}<div class="item-desc">{{description}}</div>{{/if}}
        </td>
        <td>{{unitPrice}}</td>
        <td>{{discount}}</td>
        <td style="text-align:center">{{quantity}}</td>
        <td>{{netAmount}}</td>
        <td>{{taxRate}}%</td>
        <td>
          {{#if isCgstSgst}}
          <div class="tax-split">CGST</div>
          <div class="tax-split">SGST</div>
          {{else}}
          {{taxType}}
          {{/if}}
        </td>
        <td>
          {{#if isCgstSgst}}
          <div class="tax-split">{{cgstAmount}}</div>
          <div class="tax-split">{{sgstAmount}}</div>
          {{else}}
          {{taxAmount}}
          {{/if}}
        </td>
        <td><strong>{{totalAmount}}</strong></td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- ── TOTALS ─────────────────────────────────────────────────── -->
  <div class="totals-wrap">
    <div class="totals-box">
      <div class="totals-row">
        <span>Taxable Amount</span>
        <span>{{totals.netAmount}}</span>
      </div>
      {{#if totals.hasCgstSgst}}
      <div class="totals-row indent">
        <span>CGST</span><span>{{totals.totalCgst}}</span>
      </div>
      <div class="totals-row indent">
        <span>SGST</span><span>{{totals.totalSgst}}</span>
      </div>
      {{/if}}
      {{#if totals.hasIgst}}
      <div class="totals-row indent">
        <span>IGST</span><span>{{totals.totalIgst}}</span>
      </div>
      {{/if}}
      {{#if totals.hasTax}}
      <div class="totals-row">
        <span>Total Tax</span><span>{{totals.totalTax}}</span>
      </div>
      {{/if}}
      <div class="totals-row grand">
        <span>TOTAL</span>
        <span>{{totals.grandTotal}}</span>
      </div>
    </div>
  </div>

  <!-- ── AMOUNT IN WORDS ────────────────────────────────────────── -->
  <div class="amount-words">
    Amount in Words: <span>{{totals.currency}} {{totals.grandTotalInWords}}</span>
  </div>

  <!-- ── REVERSE CHARGE ─────────────────────────────────────────── -->
  <div class="reverse-charge">
    Whether tax is payable under reverse charge - {{totals.reverseChargeLabel}}
  </div>

  <!-- ── SIGNATORY ──────────────────────────────────────────────── -->
  <div class="signatory-wrap">
    <div class="signatory-box">
      <div class="for-label">For {{seller.legalName}}:</div>
      {{#if footer.signatorySignatureDataUri}}
      <img src="{{footer.signatorySignatureDataUri}}" class="sig-img" alt="Signature">
      {{else}}
      <div class="sig-placeholder">SIGN</div>
      {{/if}}
      <div class="sig-name">{{footer.signatoryName}}</div>
      {{#if footer.signatoryDesignation}}
      <div class="sig-designation">{{footer.signatoryDesignation}}</div>
      {{/if}}
    </div>
  </div>

  <!-- ── PAYMENT DETAILS ────────────────────────────────────────── -->
  {{#if payment}}
  <table class="payment-table">
    <tr>
      {{#if payment.transactionId}}<td>Payment Transaction ID</td><td>{{payment.transactionId}}</td>{{/if}}
      {{#if payment.paidAt}}<td>Date &amp; Time</td><td>{{payment.paidAt}}</td>{{/if}}
      {{#if payment.invoiceValue}}<td>Invoice Value</td><td>{{totals.currency}} {{payment.invoiceValue}}</td>{{/if}}
      {{#if payment.paymentMethod}}<td>Mode of Payment</td><td>{{payment.paymentMethod}}</td>{{/if}}
    </tr>
  </table>
  {{/if}}

  <!-- ── NOTES ──────────────────────────────────────────────────── -->
  {{#if footer.notes}}
  <div class="section">
    <div class="section-heading">Notes</div>
    <div class="section-body">{{footer.notes}}</div>
  </div>
  {{/if}}

  <!-- ── TERMS ──────────────────────────────────────────────────── -->
  {{#if footer.termsAndConditions}}
  <div class="section">
    <div class="section-heading">Terms &amp; Conditions</div>
    <div class="section-body">{{footer.termsAndConditions}}</div>
  </div>
  {{/if}}

  <!-- ── PAGE FOOTER ────────────────────────────────────────────── -->
  <div class="page-footer">
    This is a system-generated invoice. No signature required if digitally authenticated.
  </div>

</div>
</body>
</html>
